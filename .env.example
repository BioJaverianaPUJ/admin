BACKEND_URL=https://biojaveriana.downloadablefox.dev/api/v1
PORT=4174
APP_ORIGIN=http://localhost:5173
# Use NODE_ENV=production and HTTPS APP_ORIGIN when deploying.
NODE_ENV=development

# Public basemap key, restricted in CARTO to your app origins. Never use a private API token.
VITE_CARTO_BASEMAP_KEY=

# Registros de depuración: cada respuesta del backend se imprime en la terminal
# (y en la consola del navegador en desarrollo). DEBUG_BACKEND=0 los apaga.
# DEBUG_BACKEND=1
